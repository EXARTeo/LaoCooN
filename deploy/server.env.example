# Settings of the native server deploy (deploy/deploy.sh). The first deploy copies this file to
# ~/odysseus-server/shared/settings.env (mode 600) and fills in the ZeroTier address and random secrets.
# Edit that copy, then: systemctl --user restart laocoon-proxy laocoon-eclass laocoon-mockllm

# Network. Every service listens only on BIND_ADDR (default: this host's ZeroTier address), so only devices in the
# ZeroTier network can open it. The proxy also listens on 127.0.0.1 for eClass; the mock model only on 127.0.0.1.
BIND_ADDR=
ECLASS_PORT=8181
PROXY_PORT=9100
MOCK_PORT=8998

# LLM. auto = Gemini when AI_STUDIO_API_KEY is set, otherwise the offline scripted demo model (eval/mockllm.py,
# answers only the exact demo prompts of eval/scenarios). mock / real force one or the other.
LLM_MODE=auto
AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Secrets (generated on the first deploy). The console is http://BIND_ADDR:PROXY_PORT/laocoon: operators sign in with
# a name and password from LAOCOON_CONSOLE_USERS ("name:password,name2:password2"); the first deploy creates
# admin:<random>. Left empty, the built-in demo account admin / laocoon applies and the sign-in page shows it.
# The console token still works for scripts (X-Laocoon-Token) and links (?token=).
LAOCOON_SECRET=
LAOCOON_APP_KEY=
LAOCOON_CONSOLE_TOKEN=
LAOCOON_CONSOLE_USERS=
SECRET_KEY=

# ② Siren Guard, the guardrail classifier (optional; off when all empty). See deploy/.env.example.
TYPESAFE_API_KEY=
LAOCOON_GUARD_BACKEND=
LAOCOON_GUARD_MODEL=
LAOCOON_GUARD_BASE_URL=
LAOCOON_GUARD_TIMEOUT=
LAOCOON_GUARD_LABELS=
LAOCOON_GUARD_POINTS=
# a combination (LAOCOON_GUARD_BACKEND=jev+hf): per-member settings
LAOCOON_GUARD_HF_POINTS=
LAOCOON_GUARD_HF_MODEL=
LAOCOON_GUARD_HF_LANGS=
LAOCOON_GUARD_JEV_TIMEOUT=

# Runtime settings: the console can switch single mitigations off (or tune them) while the proxy runs; every change is
# stored in the Laocoon database and audited. off = read-only: the console shows them and the environment decides.
# LAOCOON_RUNTIME_SETTINGS=on

# Policy. Unset (the default): the proxy runs ~/odysseus-server/shared/policies/eclass.yaml, the server's own copy of
# policies/eclass.yaml, and the policy studio saves drafts in shared/policies/drafts.
# LAOCOON_POLICY=
# LAOCOON_POLICY_DRAFTS=

# ⑥ attack memory (opt-in; off when empty).
LAOCOON_MEMORY=
LAOCOON_MEMORY_AUTOCONFIRM=
LAOCOON_MEMORY_DB=
LAOCOON_MEMORY_TTL_DAYS=

# eClass. RESET_DB=true: a fresh seeded database on every restart (the organisers' default).
RESET_DB=true
SHOW_TOOL_CALLS=false
