# copy to deploy/.env  (never commit deploy/.env)
AI_STUDIO_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# random, at least 32 characters (e.g. `openssl rand -hex 24`): private_data refuses a default or short secret
LAOCOON_SECRET=
LAOCOON_APP_KEY=lcn-demo-key
LAOCOON_CONSOLE_TOKEN=change-me-console
# console sign-in, "name:password,…"; empty = the demo account admin / laocoon (shown on the sign-in page)
LAOCOON_CONSOLE_USERS=
# ② Siren Guard: the guardrail classifier. Leave everything empty to run without it (deterministic layers only).
#   jev    TypeSafe System One (default when TYPESAFE_API_KEY is set), model jev-latest
#   openai any OpenAI-compatible judge: LAOCOON_GUARD_BASE_URL (e.g. http://host.docker.internal:11434/v1 for Ollama),
#          LAOCOON_GUARD_MODEL required (e.g. llama3.2)
#   hf     a Hugging Face model in-process (the proxy image must also install transformers + torch)
TYPESAFE_API_KEY=
LAOCOON_GUARD_BACKEND=
LAOCOON_GUARD_MODEL=
LAOCOON_GUARD_BASE_URL=
LAOCOON_GUARD_LABELS=
# checkpoints where the classifier is consulted (empty = all). With hf use G2,G2b,G4: the default model is English-only
#   jev+hf: both at once, the strictest answer wins, one fails -> the other's answer stands
#   per member: LAOCOON_GUARD_HF_POINTS (default G2,G2b), _HF_MODEL, _HF_LANGS (en | any), _JEV_TIMEOUT, ...
LAOCOON_GUARD_POINTS=
# ⑥ attack memory (opt-in): off | on (learn + act) | match (act only, e.g. an imported memory)
LAOCOON_MEMORY=
# signals confirmed without an admin (default canary,honey; add rejected to trust the users' rejections)
LAOCOON_MEMORY_AUTOCONFIRM=
# days an attack is kept without a match (default 90, 0 = never)
LAOCOON_MEMORY_TTL_DAYS=
